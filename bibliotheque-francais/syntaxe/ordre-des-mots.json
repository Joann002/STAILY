          "pronom": "Je le vois",
          "interrogation": "Que veux-tu ?",
          "exclamation": "Quelle belle journée nous avons !",
          "relative": "Le livre que je lis"
        }
      },
      "coi": {
        "position_normale": "Après le COD s'il y en a un",
