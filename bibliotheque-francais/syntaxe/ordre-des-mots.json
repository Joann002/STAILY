{
  "ordre_des_mots": {
    "definition": "Organisation des éléments dans la phrase française",
    "ordre_canonique": {
      "structure_base": "Sujet + Verbe + Complément(s)",
      "exemple": "Pierre mange une pomme",
      "elements": [
        "Sujet (qui fait l'action)",
        "Verbe (action ou état)", 
        "Compléments (précisions)"
      ]
    },
    "place_sujet": {
      "position_normale": "Avant le verbe",
      "exemples": ["Pierre chante", "Les enfants jouent"],
      "inversion": {
        "interrogation": {
          "exemples": ["Vient-il ?", "Où vas-tu ?", "Que fait Pierre ?"],
          "avec_pronom": "Reprise par un pronom si le sujet est un nom"
        },
        "incise": {
          "exemples": ["C'est vrai, dit-il", "Je pense, répondit-elle"],
          "position": "Après les paroles rapportées"
        },
        "mise_en_relief": {
          "exemples": ["Arrive Pierre", "Viennent ensuite les invités"],
          "effet": "Effet stylistique, littéraire"
        },
        "apres_adverbe": {
          "exemples": ["Peut-être viendra-t-il", "Ainsi parla le roi"],
          "adverbes": ["peut-être", "ainsi", "aussi", "à peine"]
        }
      }
    },
    "place_complements": {
      "cod": {
        "position_normale": "Après le verbe",
        "exemples": ["Il lit un livre", "Elle mange une pomme"],
