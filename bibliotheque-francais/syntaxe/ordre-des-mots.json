          "adjectifs_courts": ["beau", "bon", "grand", "gros", "petit", "vieux", "nouveau", "jeune"],
          "exemples": ["une belle maison", "un bon repas", "une grande voiture"],
          "changement_sens": {
            "ancien": "un ancien ami (ex-ami) / un ami ancien (âgé)",
