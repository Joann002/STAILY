          "Hier, il a plu",
          "Il a plu hier",
          "Il a, hier, beaucoup plu"
        ],
        "effets": {
          "debut": "Mise en relief, cadrage temporel",
          "fin": "Information nouvelle",
          "milieu": "Incise, précision"
        }
      }
    },
    "place_adjectifs": {
